@article{YinxiETAL25TokDrift,
  title={{TokDrift}: When {LLM} Speaks in Subwords but Code Speaks in Grammar},
  author={Yinxi Li and Yuntian Deng and Pengyu Nie},
  journal={arXiv preprint arXiv:2510.14972},
  year={2025},
  url={https://arxiv.org/abs/2510.14972},
  arxiv={2510.14972},
  pdf={Arxiv_TokDrift.pdf},
  preview={TokDrift_example.gif},
  abstract={Large Language Models have demonstrated remarkable capabilities in code generation, yet they exhibit a fundamental limitation: generating code token-by-token according to their internal tokenizer, which often misaligns with the syntactic structures defined by programming language grammars. This misalignment, which we term TokDrift, creates systematic biases that affect model performance. In this work, we introduce TokDrift Theory to formalize this phenomenon and provide a systematic analysis of its impact on LLM behavior. Through extensive experiments across multiple state-of-the-art models, we demonstrate that TokDrift significantly influences code generation quality, with effects varying by tokenizer design and programming language syntax. We further show that traditional evaluation metrics fail to account for these tokenization effects, potentially leading to misleading conclusions about model capabilities. Our findings suggest that addressing TokDrift through grammar-aware tokenization or constrained decoding represents a promising direction for improving code generation reliability.},
  bibtex_show={true},
  selected={true}
}